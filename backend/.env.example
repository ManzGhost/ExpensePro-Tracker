# MongoDB Connection URI (e.g., local MongoDB or MongoDB Atlas cluster)
MONGODB_URI=mongodb://localhost:27017/expenseflow

# Secret key used for signing JWT authentication tokens (min 256 bits)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_256_bits

# Server Port (Default is 8080)
PORT=8080

# Comma-separated CORS allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
