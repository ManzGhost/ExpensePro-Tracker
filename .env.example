# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Spring Boot Backend Environment Variables
MONGODB_URI="mongodb://localhost:27017/expenseflow"
JWT_SECRET="your_jwt_secret_key_change_in_production_min_256_bits"

# Production Backend URLs (Dono ko Render URL par set karein)
VITE_API_URL="https://expensepro-tracker.onrender.com/api"
VITE_API_BASE_URL="https://expensepro-tracker.onrender.com/api"